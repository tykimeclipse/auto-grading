# 서버 바인딩
# 운영 시 HOST=0.0.0.0 + Cloudflare Tunnel 권장.
# 개발 시 127.0.0.1 으로 두면 외부 노출 차단.
PORT=8787
HOST=127.0.0.1

# 데이터 저장 디렉터리 (절대 경로 권장).
# 디렉터리 구조: ${DATA_DIR}/students/{student_id}/{note_id}/{images|thumbs|exports}/{uuid}.webp
DATA_DIR=./data/mistake-notes

# PDF 한글 헤더용 폰트 디렉터리.
# ${FONT_DIR}/NotoSansKR-Regular.ttf 가 있으면 한글 헤더 포함,
# 없으면 PDF 헤더가 날짜 등 ASCII 로만 표시됨.
FONT_DIR=./assets/fonts

# Supabase (anon 키만 사용 — service_role 키 사용 금지)
SUPABASE_URL=https://gspsquuyqkydqphbcuel.supabase.co
SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# CORS 허용 origin (쉼표 구분)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# 업로드/이미지 제한
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_LONG_EDGE=1600
THUMBNAIL_LONG_EDGE=300
WEBP_QUALITY=80

# 로그 레벨 (info, warn, error, debug)
LOG_LEVEL=info
